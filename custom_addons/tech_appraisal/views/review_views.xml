<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tech_appraisal_review_view_list" model="ir.ui.view">
        <field name="name">tech.appraisal.review.list</field>
        <field name="model">tech.appraisal.review</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" default_order="state, cycle_id desc, employee_id">
                <field name="employee_id"/>
                <field name="cycle_id"/>
                <field name="reviewer_id"/>
                <field name="deadline"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="avg_score"/>
                <field name="write_date" string="Last updated" optional="show"/>
                <field name="can_edit" string="Editable" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'submitted'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="tech_appraisal_review_view_form" model="ir.ui.view">
        <field name="name">tech.appraisal.review.form</field>
        <field name="model">tech.appraisal.review</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit Review" class="btn-primary"
                            invisible="state != 'draft' or cycle_state == 'closed'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'submitted' or cycle_state == 'closed'"
                            groups="hr.group_hr_user"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="cycle_state != 'closed'">
                    This cycle is closed: the review is locked.
                </div>
                <div class="alert alert-info mb-0" role="status"
                     invisible="state != 'submitted' or not can_edit or not deadline">
                    Submitted. You can still change this review until the end of its deadline day.
                </div>
                <div class="alert alert-info mb-0" role="status"
                     invisible="state != 'submitted' or not can_edit or deadline">
                    Submitted. You can still change this review until the cycle is closed.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'submitted' or can_edit or cycle_state == 'closed'">
                    The deadline has passed: this review is locked. Ask HR to reopen it if it must be corrected.
                </div>
                <sheet>
                    <field name="cycle_state" invisible="1"/>
                    <field name="can_edit" invisible="1"/>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="cycle_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reviewer_id" readonly="1"/>
                            <field name="deadline"/>
                            <field name="avg_score"/>
                        </group>
                    </group>
                    <group string="Scores (click the stars)">
                        <label for="score_technical" string="Technical skill"/>
                        <div>
                            <field name="score_technical" widget="priority" nolabel="1" readonly="not can_edit"/>
                        </div>
                        <label for="score_teamwork" string="Teamwork"/>
                        <div>
                            <field name="score_teamwork" widget="priority" nolabel="1" readonly="not can_edit"/>
                        </div>
                        <label for="score_delivery" string="Delivery"/>
                        <div>
                            <field name="score_delivery" widget="priority" nolabel="1" readonly="not can_edit"/>
                        </div>
                        <label for="score_communication" string="Communication"/>
                        <div>
                            <field name="score_communication" widget="priority" nolabel="1" readonly="not can_edit"/>
                        </div>
                        <label for="score_ownership" string="Ownership &amp; initiative"/>
                        <div>
                            <field name="score_ownership" widget="priority" nolabel="1" readonly="not can_edit"/>
                        </div>
                        <label for="score_learning" string="Learning &amp; knowledge sharing"/>
                        <div>
                            <field name="score_learning" widget="priority" nolabel="1" readonly="not can_edit"/>
                        </div>
                    </group>
                    <group string="Feedback">
                        <field name="comment" nolabel="1" colspan="2" readonly="not can_edit"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tech_appraisal_review_view_search" model="ir.ui.view">
        <field name="name">tech.appraisal.review.search</field>
        <field name="model">tech.appraisal.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="reviewer_id"/>
                <field name="cycle_id"/>
                <filter name="todo" string="To Do" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="editable" string="Still editable"
                        domain="[('state', '=', 'submitted'), ('cycle_id.state', '!=', 'closed'), '|', ('deadline', '=', False), ('deadline', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '=', 'draft'), ('cycle_id.state', '!=', 'closed'), ('deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_id'}"/>
                    <filter name="group_employee" string="Reviewed employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_reviewer" string="Reviewer" context="{'group_by': 'reviewer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tech_appraisal_review_action_mine" model="ir.actions.act_window">
        <field name="name">My Reviews</field>
        <field name="res_model">tech.appraisal.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('reviewer_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_group_cycle': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reviews yet</p>
            <p>Reviews you are asked to write appear here. Once submitted they stay here as your history,
            and you can still change them until the deadline.</p>
        </field>
    </record>

    <record id="tech_appraisal_review_action_all" model="ir.actions.act_window">
        <field name="name">All Reviews</field>
        <field name="res_model">tech.appraisal.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Extend appraisal form / cycle form -->
    <record id="tech_appraisal_view_form_reviews" model="ir.ui.view">
        <field name="name">tech.appraisal.form.reviews</field>
        <field name="model">tech.appraisal</field>
        <field name="inherit_id" ref="tech_appraisal_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_reset']" position="after">
                <button name="action_generate_reviews" type="object" string="Request Peer Reviews"
                        groups="hr.group_hr_user"/>
            </xpath>
            <xpath expr="//sheet/group[last()]" position="after">
                <group string="Peer Reviews">
                    <field name="review_submitted_count" string="Submitted"/>
                    <field name="review_count" string="Requested"/>
                    <field name="peer_avg_score" string="Peer average"/>
                </group>
                <notebook groups="hr.group_hr_user">
                    <page string="Individual Reviews" name="reviews">
                        <field name="review_ids">
                            <list>
                                <field name="reviewer_id"/>
                                <field name="avg_score"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="tech_appraisal_view_list_peer" model="ir.ui.view">
        <field name="name">tech.appraisal.list.peer</field>
        <field name="model">tech.appraisal</field>
        <field name="inherit_id" ref="tech_appraisal_view_list"/>
        <field name="arch" type="xml">
            <field name="avg_score" position="after">
                <field name="peer_avg_score"/>
            </field>
        </field>
    </record>

    <record id="tech_appraisal_cycle_view_form_reviews" model="ir.ui.view">
        <field name="name">tech.appraisal.cycle.form.reviews</field>
        <field name="model">tech.appraisal.cycle</field>
        <field name="inherit_id" ref="tech_appraisal_cycle_view_form"/>
        <field name="arch" type="xml">
            <button name="action_generate_appraisals" position="after">
                <button name="action_generate_reviews" type="object" string="Request Peer Reviews"
                        invisible="state == 'closed'"/>
            </button>
        </field>
    </record>
</odoo>
