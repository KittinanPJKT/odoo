<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_appraisal_own_or_team" model="ir.rule">
        <field name="name">Appraisal: own or direct reports</field>
        <field name="model_id" ref="model_tech_appraisal"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', '|',
            ('employee_id.user_id', '=', user.id),
            ('manager_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_appraisal_hr_all" model="ir.rule">
        <field name="name">Appraisal: HR sees all</field>
        <field name="model_id" ref="model_tech_appraisal"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
