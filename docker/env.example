# Copy to ".env" next to docker-compose.yml:   cp docker/env.example .env
# ".env" is ignored by git (the repository ignores every dotfile). Never commit real passwords.

# PostgreSQL superuser used by Odoo (created by the db container on first start)
DB_USER=odoo
DB_PASSWORD=change-me

# Database Odoo serves, and the port published on your machine
ODOO_DB=odoo
ODOO_PORT=8069

# Modules installed by "init"
ODOO_MODULES=hr,tech_appraisal,project,hr_timesheet,hr_holidays

# Password of the demo logins somchai / malee (local use only)
DEMO_PASSWORD=demo1234
